# Copy this file to .env and fill in the values. Never commit .env.

# Google OAuth client ("Web application") from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Must exactly match an "Authorized redirect URI" on that OAuth client
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Long random string that signs the admin session cookie (generate one with: openssl rand -hex 32)
SESSION_SECRET=replace-with-a-long-random-string

# Comma-separated Google accounts allowed into the Admin Dashboard (case-insensitive)
ADMIN_EMAILS=admin-one@example.com,admin-two@example.com

# Optional
PORT=8000
# Club time zone, used for registration deadlines and dates
TZ=America/Los_Angeles
# Hours before an admin has to sign in again (default 8)
SESSION_TTL_HOURS=8
# Folder for each sport's club data, e.g. server/data/pickleball.json (default server/data)
# DATA_DIR=server/data
# Set to 1 when running behind an HTTPS reverse proxy
# TRUST_PROXY=1
